# Docker Compose Environment Configuration
# Copy this file to .env and set appropriate values

# Backend image version (without 'v' prefix, or use 'latest')
BACKEND_VERSION=latest

# Frontend image version (without 'v' prefix, or use 'latest')
FRONTEND_VERSION=latest

# Active Spring profiles (comma-separated).
# 'local'  — persistent file-based H2, full actuator endpoints (default for docker-compose).
# 'prod'   — PostgreSQL datasource, health-only actuator.
SPRING_PROFILES_ACTIVE=local

# ── Datasource (local profile) ────────────────────────────────────────────────
# H2_DB_PATH — bare file path for the H2 database used by the 'local' profile.
# The jdbc:h2:file: prefix and connection options are added automatically by
# application-local.yml, so supply the path only (no jdbc: prefix).
# Default when unset: ./data/tradelab  (relative to the process working directory)
#
# H2_DB_PATH=/absolute/path/to/your/db
#
# NOTE: Do NOT set DATASOURCE_URL when using the local profile — it expects a
# full JDBC URL and will cause a startup failure if given a bare file path.
# DATASOURCE_URL is reserved for the prod profile (PostgreSQL full JDBC URL).

# ── Datasource (prod profile) ─────────────────────────────────────────────────
# DATASOURCE_URL=jdbc:postgresql://localhost:5432/tradelab

# Google OAuth2 Configuration (optional for OIDC login)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Example with specific version:
# BACKEND_VERSION=1.0.0
# FRONTEND_VERSION=1.0.0
