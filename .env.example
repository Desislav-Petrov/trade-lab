# Docker Compose Environment Configuration
# Copy this file to .env and set appropriate values

# Backend image version (without 'v' prefix, or use 'latest')
BACKEND_VERSION=latest

# Frontend image version (without 'v' prefix, or use 'latest')
FRONTEND_VERSION=latest

# Active Spring profiles (comma-separated).
# 'local'  — persistent file-based H2, full actuator endpoints (default for docker-compose).
# 'prod'   — PostgreSQL datasource, health-only actuator.
SPRING_PROFILES_ACTIVE=local

# Google OAuth2 Configuration (optional for OIDC login)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Example with specific version:
# BACKEND_VERSION=1.0.0
# FRONTEND_VERSION=1.0.0
